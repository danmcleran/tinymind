# find_package(tinymind): defines tinymind::tinymind (the headers) and
# tinymind::lookup_tables (cpp/lookupTables.cpp, compiled with the lookup
# tables chosen when tinymind was installed).

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/tinymindTargets.cmake")
check_required_components(tinymind)
